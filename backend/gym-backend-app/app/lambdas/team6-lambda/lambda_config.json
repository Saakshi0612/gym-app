{
  "version": "1.0",
  "name": "team6-lambda",
  "func_name": "lambdas/team6-lambda/dist/index.handler",
  "resource_type": "lambda",
  "iam_role_name": "team6-lambda-role",
  "runtime": "nodejs20.x",
  "memory": 128,
  "timeout": 100,
  "lambda_path": "lambdas\\team6-lambda",
  "dependencies": [{
    "resource_name":"my-user-pool",
    "resource_type":"cognito_idp"
  }],
  "event_sources": [],
  "env_variables": {
    "MONGO_URI":"${MONGO_URI}",
    "USER_POOL_ID":{
      "resource_name":"my-user-pool",
      "resource_type":"cognito_idp",
      "parameter":"id"
    },
    "CLIENT_ID":{
      "resource_name":"my-user-pool",
      "resource_type":"cognito_idp",
      "parameter":"client_id"
    }
  },
  "publish_version": true,
  "alias": "${lambdas_alias_name}",
  "url_config": {},
  "ephemeral_storage": 512,
  "tags": {}
}